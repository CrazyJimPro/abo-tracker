# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
prod-server.log
prod-server.err.log
.server.pid

# Windows: bootstrap.ps1's install transcript, and the portable Node.js
# runtime install.ps1 downloads when no suitable Node is on PATH
/install.log
/node-runtime

# Windows installer: transient handoff of a freshly generated admin
# password from install.ps1 to setup.iss's post-install dialog
.admin-credentials.txt

# Windows installer: short-lived helper scripts install.ps1 writes into the
# project root (require() resolves relative to the script's own folder, so
# they cannot live in %TEMP%). Removed right after use - unless the install
# is interrupted in between.
.abo-tracker-*.js

# local database — real data and password hashes, never commit
/data

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (personal, machine-local permission grants)
.claude/settings.local.json

# Windows installer build output (iscc setup.iss)
/installscript/windows/dist
